<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Child — <%= user.firstName %> <%= user.lastName %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/users" class="navbar-brand">&#128106; Family Management</a>
      <div class="navbar-links">
        <a href="/users">All Users</a>
        <a href="/users#createSection">+ Create User</a>
      </div>
    </div>
  </nav>

  <div class="container">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/users/<%= user._id %>">&#8592; Back to <%= user.firstName %>'s Profile</a>
    </div>

    <!-- Parent Info -->
    <div class="card">
      <div class="card-header">
        <h2>&#128100; Adding child for</h2>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">Parent Name</span>
            <span class="info-value"><%= user.firstName %> <%= user.lastName %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Parent Email</span>
            <span class="info-value"><%= user.email %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Parent ID</span>
            <span class="id-text"><%= user._id %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Child Form -->
    <div class="card">
      <div class="card-header">
        <h2>&#128118; New Child Details</h2>
      </div>
      <div class="card-body">
        <div id="formMessage"></div>

        <form id="addChildForm">
          <div class="form-grid">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input type="text" id="firstName" name="firstName" placeholder="e.g. Ali" required />
            </div>

            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input type="text" id="lastName" name="lastName" placeholder="e.g. Khan" required />
            </div>

            <div class="form-group">
              <label for="age">Age</label>
              <input type="number" id="age" name="age" placeholder="e.g. 8" required min="0" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="e.g. ali@example.com" required />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-success">Add Child</button>
            <a href="/users/<%= user._id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- Existing JS logic (unchanged) -->
  <script>
    document.getElementById("addChildForm").addEventListener("submit", function(e) {
      e.preventDefault();

      var data = {
        firstName: document.getElementById("firstName").value,
        lastName: document.getElementById("lastName").value,
        age: document.getElementById("age").value,
        email: document.getElementById("email").value
      };

      fetch("/users/<%= user._id %>/children", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data)
      })
      .then(function(response) { return response.json(); })
      .then(function(result) {
        var msgDiv = document.getElementById("formMessage");
        if (result.message) {
          msgDiv.className = "message success";
          msgDiv.textContent = result.message;
          // Redirect to parent profile after short delay
          setTimeout(function() {
            window.location.href = "/users/<%= user._id %>";
          }, 1000);
        } else if (result.error) {
          msgDiv.className = "message error";
          msgDiv.textContent = result.error;
        }
      })
      .catch(function(err) {
        var msgDiv = document.getElementById("formMessage");
        msgDiv.className = "message error";
        msgDiv.textContent = "Error adding child. Please try again.";
      });
    });
  </script>
</body>
</html>
