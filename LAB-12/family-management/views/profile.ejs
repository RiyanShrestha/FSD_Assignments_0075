<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile — <%= user.firstName %> <%= user.lastName %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="/users" class="navbar-brand">&#128106; Family Management</a>
      <div class="navbar-links">
        <a href="/users">All Users</a>
        <a href="/users#createSection">+ Create User</a>
      </div>
    </div>
  </nav>

  <div class="container">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/users">&#8592; All Users</a>
    </div>

    <!-- Profile Card -->
    <div class="card">
      <div class="card-header">
        <h2>&#128100; User Profile</h2>
        <span class="id-text">ID: <%= user._id %></span>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">Full Name</span>
            <span class="info-value"><%= user.firstName %> <%= user.lastName %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Email</span>
            <span class="info-value"><%= user.email %></span>
          </div>
          <div class="info-item">
            <span class="info-label">Phone</span>
            <span class="info-value"><%= user.phone %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Children Section -->
    <div class="card">
      <div class="card-header">
        <h2>&#128118; Children (<%= children.length %>)</h2>
        <a href="/users/<%= user._id %>/children/add" class="btn btn-success btn-sm">+ Add Child</a>
      </div>

      <% if (children.length === 0) { %>
        <div class="card-body">
          <div class="empty-state">
            <div class="empty-icon">&#128118;</div>
            <p>No children found for this user.</p>
            <br />
            <a href="/users/<%= user._id %>/children/add" class="btn btn-success">+ Add First Child</a>
          </div>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% children.forEach(function(child) { %>
                <tr>
                  <td>
                    <a href="/users/<%= user._id %>/children/<%= child._id %>">
                      <strong><%= child.firstName %> <%= child.lastName %></strong>
                    </a>
                  </td>
                  <td><%= child.age %></td>
                  <td><%= child.email %></td>
                  <td>
                    <div class="action-btns">
                      <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-primary btn-sm">View</a>
                      <button class="btn btn-danger btn-sm" onclick="deleteChild('<%= child._id %>', '<%= user._id %>')">Delete</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>

  <!-- Delete Child Script (unchanged logic) -->
  <script>
    function deleteChild(childId, userId) {
      if (confirm("Are you sure you want to delete this child?")) {
        fetch("/children/" + childId, { method: "DELETE" })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            alert(data.message || "Child deleted");
            window.location.href = "/users/" + userId;
          })
          .catch(function(err) {
            alert("Error deleting child");
          });
      }
    }
  </script>
</body>
</html>
