<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= student.fullName %> - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students" class="active">Students</a></li>
        <li><a href="/lost-items">Lost Items</a></li>
        <li><a href="/found-items">Found Items</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <div class="detail-container">
      <a href="/students" class="back-link">&larr; Back to Students</a>
      <h1><%= student.fullName %></h1>

      <div class="detail-card">
        <div class="detail-row">
          <span class="label">Email:</span>
          <span><%= student.email %></span>
        </div>
        <div class="detail-row">
          <span class="label">Department:</span>
          <span><%= student.department %></span>
        </div>
        <div class="detail-row">
          <span class="label">Contact Number:</span>
          <span><%= student.contactNumber %></span>
        </div>
        <div class="detail-row">
          <span class="label">Registered On:</span>
          <span><%= student.createdAt.toLocaleDateString() %></span>
        </div>
      </div>

      <h2>Lost Item Reports</h2>
      <% if (lostItems.length === 0) { %>
        <p class="muted">This student has not reported any lost items.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Category</th>
              <th>Status</th>
              <th>Date Lost</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% lostItems.forEach(function(item) { %>
              <tr>
                <td><%= item.itemName %></td>
                <td><%= item.category %></td>
                <td><span class="status status-<%= item.status.toLowerCase() %>"><%= item.status %></span></td>
                <td><%= item.dateLost.toLocaleDateString() %></td>
                <td><a href="/lost-items/<%= item._id %>" class="btn btn-small">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>

      <h2>Found Item Reports</h2>
      <% if (foundItems.length === 0) { %>
        <p class="muted">This student has not reported any found items.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Category</th>
              <th>Status</th>
              <th>Date Found</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% foundItems.forEach(function(item) { %>
              <tr>
                <td><%= item.itemName %></td>
                <td><%= item.category %></td>
                <td><span class="status status-<%= item.status.toLowerCase() %>"><%= item.status %></span></td>
                <td><%= item.dateFound.toLocaleDateString() %></td>
                <td><a href="/found-items/<%= item._id %>" class="btn btn-small">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
