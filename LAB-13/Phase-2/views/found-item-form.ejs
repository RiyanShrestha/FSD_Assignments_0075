<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Found Item - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students">Students</a></li>
        <li><a href="/lost-items">Lost Items</a></li>
        <li><a href="/found-items" class="active">Found Items</a></li>
        <% if (typeof currentStudent !== 'undefined' && currentStudent) { %>
          <li><a href="/students/<%= currentStudent._id %>" class="user-badge" title="Logged in as <%= currentStudent.fullName %>">👤 <%= currentStudent.fullName %></a></li>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/login?redirect=/found-items/new">Login</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <main>
    <div class="form-container">
      <h1>Report Found Item</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (students.length === 0) { %>
        <div class="alert alert-error">
          No students registered yet. <a href="/students/new">Register a student</a> before reporting items.
        </div>
      <% } else { %>
        <form action="/found-items" method="POST">
          <div class="form-group">
            <label for="itemName">Item Name *</label>
            <input type="text" id="itemName" name="itemName" 
                   value="<%= typeof itemName !== 'undefined' ? itemName : '' %>" 
                   placeholder="e.g. Black Umbrella" required>
          </div>

          <div class="form-group">
            <label for="category">Category *</label>
            <select id="category" name="category" required>
              <option value="">Select Category</option>
              <option value="Electronics" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Electronics' ? 'selected' : '' %>>Electronics</option>
              <option value="Books" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Books' ? 'selected' : '' %>>Books</option>
              <option value="Clothing" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Clothing' ? 'selected' : '' %>>Clothing</option>
              <option value="Accessories" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Accessories' ? 'selected' : '' %>>Accessories</option>
              <option value="Documents" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Documents' ? 'selected' : '' %>>Documents</option>
              <option value="Keys" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Keys' ? 'selected' : '' %>>Keys</option>
              <option value="Bags" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Bags' ? 'selected' : '' %>>Bags</option>
              <option value="Other" <%= typeof categoryVal !== 'undefined' && categoryVal === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="description">Description *</label>
            <textarea id="description" name="description" rows="4" 
                      placeholder="Describe the item in detail..." required><%= typeof description !== 'undefined' ? description : '' %></textarea>
          </div>

          <div class="form-group">
            <label for="foundLocation">Found Location *</label>
            <input type="text" id="foundLocation" name="foundLocation" 
                   value="<%= typeof foundLocation !== 'undefined' ? foundLocation : '' %>" 
                   placeholder="e.g. Cafeteria, Main Building" required>
          </div>

          <div class="form-group">
            <label for="dateFound">Date Found *</label>
            <input type="date" id="dateFound" name="dateFound" 
                   value="<%= typeof dateFound !== 'undefined' ? dateFound : '' %>" required>
          </div>

          <div class="form-group">
            <label for="reportedBy">Reported By (Student) *</label>
            <select id="reportedBy" name="reportedBy" required>
              <option value="">Select Student</option>
              <% 
                const activeReporter = (typeof reportedBy !== 'undefined' && reportedBy) 
                  ? reportedBy.toString() 
                  : ((typeof currentStudent !== 'undefined' && currentStudent) ? currentStudent._id.toString() : '');
              %>
              <% students.forEach(function(student) { %>
                <option value="<%= student._id %>" 
                        <%= activeReporter === student._id.toString() ? 'selected' : '' %>>
                  <%= student.fullName %> (<%= student.email %>)
                </option>
              <% }); %>
            </select>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Submit Report</button>
            <a href="/found-items" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      <% } %>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
