<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students">Students</a></li>
        <li><a href="/lost-items">Lost Items</a></li>
        <li><a href="/found-items">Found Items</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <div class="error-page">
      <h1>Oops!</h1>
      <h2>Something went wrong</h2>
      <p><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
      <a href="/" class="btn btn-primary">Go to Home</a>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
