<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Students - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students" class="active">Students</a></li>
        <li><a href="/lost-items">Lost Items</a></li>
        <li><a href="/found-items">Found Items</a></li>
        <% if (typeof currentStudent !== 'undefined' && currentStudent) { %>
          <li><a href="/students/<%= currentStudent._id %>" class="user-badge" title="Logged in as <%= currentStudent.fullName %>">👤 <%= currentStudent.fullName %></a></li>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/login?redirect=/students">Login</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <main>
    <div class="page-header">
      <h1>Registered Students</h1>
      <a href="/students/new" class="btn btn-primary">+ Register Student</a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (students.length === 0) { %>
      <div class="empty-state">
        <h2>No students registered yet</h2>
        <p>Register a student first before reporting lost or found items.</p>
        <a href="/students/new" class="btn btn-primary">Register First Student</a>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Contact</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(student) { %>
            <tr>
              <td><%= student.fullName %></td>
              <td><%= student.email %></td>
              <td><%= student.department %></td>
              <td><%= student.contactNumber %></td>
              <td>
                <div class="actions-inline">
                  <a href="/students/<%= student._id %>" class="btn btn-small">View</a>
                  <% const isCurrent = (typeof currentStudent !== 'undefined' && currentStudent && currentStudent._id.toString() === student._id.toString()); %>
                  <% if (isCurrent) { %>
                    <span style="font-size: 0.8rem; color: #16a34a; font-weight: 600;">Active</span>
                  <% } else { %>
                    <form action="/login" method="POST" style="margin: 0; display: inline;">
                      <input type="hidden" name="studentId" value="<%= student._id %>">
                      <input type="hidden" name="redirect" value="/students">
                      <button type="submit" class="btn btn-small btn-secondary" title="Log in as this student">Log In</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
