<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Students - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students" class="active">Students</a></li>
        <li><a href="/lost-items">Lost Items</a></li>
        <li><a href="/found-items">Found Items</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <div class="page-header">
      <h1>Registered Students</h1>
      <a href="/students/new" class="btn btn-primary">+ Register Student</a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (students.length === 0) { %>
      <div class="empty-state">
        <h2>No students registered yet</h2>
        <p>Register a student first before reporting lost or found items.</p>
        <a href="/students/new" class="btn btn-primary">Register First Student</a>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Contact</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(student) { %>
            <tr>
              <td><%= student.fullName %></td>
              <td><%= student.email %></td>
              <td><%= student.department %></td>
              <td><%= student.contactNumber %></td>
              <td><a href="/students/<%= student._id %>" class="btn btn-small">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
