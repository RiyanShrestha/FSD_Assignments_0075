<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= item.itemName %> - Lost Item - Campus Lost & Found</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">🔍 Campus Lost & Found</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/students">Students</a></li>
        <li><a href="/lost-items" class="active">Lost Items</a></li>
        <li><a href="/found-items">Found Items</a></li>
        <% if (typeof currentStudent !== 'undefined' && currentStudent) { %>
          <li><a href="/students/<%= currentStudent._id %>" class="user-badge" title="Logged in as <%= currentStudent.fullName %>">👤 <%= currentStudent.fullName %></a></li>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/login?redirect=/lost-items/<%= item._id %>">Login</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <main>
    <div class="detail-container">
      <a href="/lost-items" class="back-link">&larr; Back to Lost Items</a>
      <h1><%= item.itemName %></h1>
      <span class="status status-<%= (item.status || 'lost').toLowerCase() %>"><%= item.status || 'Lost' %></span>

      <div class="detail-card">
        <div class="detail-row">
          <span class="label">Category:</span>
          <span><%= item.category %></span>
        </div>
        <div class="detail-row">
          <span class="label">Description:</span>
          <span><%= item.description %></span>
        </div>
        <div class="detail-row">
          <span class="label">Last Seen Location:</span>
          <span><%= item.lastSeenLocation %></span>
        </div>
        <div class="detail-row">
          <span class="label">Date Lost:</span>
          <span><%= item.dateLost ? new Date(item.dateLost).toLocaleDateString() : 'N/A' %></span>
        </div>
        <div class="detail-row">
          <span class="label">Reported By:</span>
          <span>
            <% if (item.reportedBy && item.reportedBy.fullName) { %>
              <a href="/students/<%= item.reportedBy._id %>"><%= item.reportedBy.fullName %></a>
              (<%= item.reportedBy.email %>)
            <% } else { %>
              <em>Unknown student</em>
            <% } %>
          </span>
        </div>
        <div class="detail-row">
          <span class="label">Reported On:</span>
          <span><%= item.createdAt ? new Date(item.createdAt).toLocaleDateString() : 'N/A' %></span>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Campus Lost & Found Management System</p>
  </footer>
</body>
</html>
